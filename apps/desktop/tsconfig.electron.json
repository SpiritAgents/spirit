{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist-electron",
    "rootDir": ".",
    "noEmit": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo-electron"
  },
  "include": [
    "electron/**/*.ts",
    "src/env.d.ts",
    "src/lib/desktop-notification-types.ts",
    "src/lib/docs-links.ts",
    "src/lib/edit-command-state.ts",
    "src/lib/live-update.ts",
    "src/lib/translucency.ts",
    "src/lib/ui-locale.ts",
    "src/lib/i18n-host.ts",
    "src/lib/windows-jump-list-build.ts",
    "src/lib/windows-launch-argv.ts",
    "src/lib/windows-toast-xml.ts",
    "electron/sync-windows-jump-list.ts",
    "src/types.ts"
  ],
  "exclude": ["electron/preload.ts"]
}
