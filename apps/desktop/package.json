{
  "name": "@spiritagent/desktop",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Desktop application for Spirit",
  "homepage": "https://github.com/SpiritAgents/spirit",
  "license": "MIT",
  "author": {
    "name": "Spirit contributors",
    "email": "121384036+N123999@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "scripts": {
    "build:deps": "pnpm exec turbo run build --filter=\"@spiritagent/desktop^...\"",
    "ensure:dev-built": "node scripts/gen-brand-assets.mjs && pnpm exec turbo run build:electron --filter=@spiritagent/desktop && node scripts/ensure-pty-spawn-helper.mjs && node scripts/ensure-dev-electron-bundle.mjs",
    "postinstall": "node scripts/ensure-pty-spawn-helper.mjs",
    "dev": "pnpm run ensure:dev-built && concurrently -k -n electron,renderer \"pnpm run dev:electron:run\" \"pnpm run dev:renderer\"",
    "dev:renderer": "vite --strictPort --host 127.0.0.1 --port 1420",
    "dev:electron": "pnpm run ensure:dev-built && wait-on tcp:127.0.0.1:1420 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 node scripts/run-dev-electron.mjs dist-electron/electron/main.js",
    "dev:electron:run": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 node scripts/run-dev-electron.mjs dist-electron/electron/main.js",
    "dev:web": "pnpm run ensure:dev-built && concurrently -k -n host,renderer \"pnpm run dev:web:host\" \"pnpm run dev:web:renderer\"",
    "dev:web:host": "node dist-electron/electron/web-host.js",
    "dev:web:renderer": "vite --host 127.0.0.1 --port 5173",
    "build:host-internal": "pnpm exec turbo run build --filter=@spiritagent/host-internal",
    "build:app": "pnpm run build:deps && pnpm run build:renderer && pnpm run build:electron",
    "build": "pnpm run build:app",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.cjs.json && node ./scripts/rename-preload-to-cjs.mjs",
    "dist": "node scripts/gen-brand-assets.mjs && node scripts/ensure-packaged-ripgrep.mjs && pnpm run build:app && electron-builder --config electron-builder.yml",
    "dist:dir": "node scripts/gen-brand-assets.mjs && node scripts/ensure-packaged-ripgrep.mjs && pnpm run build:app && electron-builder --config electron-builder.yml --dir",
    "test": "pnpm run test:lib && pnpm run test:host",
    "test:host": "pnpm run build:electron && vitest run test/host",
    "test:lib": "node scripts/check-renderer-host-internal-imports.mjs && node scripts/check-renderer-agent-core-imports.mjs && pnpm run build:electron && vitest run --exclude 'test/host/**'",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node scripts/run-dev-electron.mjs dist-electron/electron/main.js",
    "gen:brand-assets": "node scripts/gen-brand-assets.mjs",
    "notice": "node scripts/gen-notice.mjs",
    "notice:production": "node scripts/gen-notice.mjs --production",
    "rebuild:pty": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@lexical/clipboard": "0.46.0",
    "@lexical/headless": "0.46.0",
    "@lexical/history": "0.46.0",
    "@lexical/plain-text": "0.46.0",
    "@lexical/react": "0.46.0",
    "@lexical/rich-text": "0.46.0",
    "@lexical/utils": "0.46.0",
    "@napi-rs/keyring": "1.3.0",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@shikijs/monaco": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/brand": "workspace:*",
    "@spiritagent/host-internal": "workspace:*",
    "@spiritagent/server": "workspace:*",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "gitdiff-parser": "0.3.1",
    "hast-util-sanitize": "5.0.2",
    "i18next": "26.3.0",
    "katex": "0.17.0",
    "koffi": "2.16.3",
    "lexical": "0.46.0",
    "lucide-react": "1.28.0",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.8",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "3.23.0",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "license-checker-rseidelsohn": "5.0.1",
    "linkedom": "0.18.13",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
