{
  "name": "@spiritagent/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../packages/product/scripts/run-quality.mjs dev pnpm run dev:run",
    "dev:run": "pnpm exec turbo run build --filter=\"@spiritagent/site^...\" && node scripts/generate-brand-assets.mjs && node scripts/dev.mjs",
    "build": "node ../../scripts/product/generate-content.mjs --scope site && node scripts/generate-brand-assets.mjs && node scripts/generate-notice.mjs && node scripts/generate-install-scripts.mjs && tsx scripts/generate-markdown-companions.mjs && next build",
    "start": "next start",
    "test": "node ../../scripts/product/generate-content.mjs --scope site && tsx --test scripts/*.test.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "brand-assets": "node scripts/generate-brand-assets.mjs",
    "notice": "node scripts/generate-notice.mjs",
    "install-scripts": "node scripts/generate-install-scripts.mjs",
    "markdown-companions": "tsx scripts/generate-markdown-companions.mjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@spiritagent/icons": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "@spiritagent/ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.14.3",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.3",
    "lucide-react": "^1.14.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.4.2"
}
