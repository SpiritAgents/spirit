{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pnpm",
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm",
      "args": ["lint"],
      "problemMatcher": []
    },
    {
      "label": "Check Formatting",
      "type": "shell",
      "command": "pnpm",
      "args": ["format"],
      "problemMatcher": []
    },
    {
      "label": "Start Desktop",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@spiritagent/desktop", "start"],
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Desktop (Dev)",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev:desktop"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Site",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev:site"],
      "problemMatcher": []
    },
    {
      "label": "Start CLI",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev:cli"],
      "problemMatcher": []
    }
  ]
}