{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "product.json",
    "packages/product/schema.ts",
    "packages/product/scripts/generate.mjs",
    "scripts/product/generate-content.mjs"
  ],
  "globalEnv": ["SPIRIT_PRODUCT_QUALITY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", ".next/**", ".source/**"],
      "env": ["SITE_URL"]
    },
    "@spiritagent/site#build": {
      "dependsOn": ["^build"],
      "env": ["SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/desktop/src/locales/*.json"],
      "outputs": [".next/**", ".source/**", ".generated/**", "public/**"]
    },
    "@spiritagent/host-internal#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:tsc": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:electron": {
      "dependsOn": ["^build"],
      "outputs": ["dist-electron/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    }
  }
}
