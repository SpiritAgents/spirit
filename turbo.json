{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "product.json",
    "packages/product/schema.ts",
    "packages/product/scripts/generate.mjs"
  ],
  "globalEnv": ["SPIRIT_PRODUCT_QUALITY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", ".next/**", ".source/**"],
      "passThroughEnv": ["SITE_URL"]
    },
    "build:tsc": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:electron": {
      "dependsOn": ["^build"],
      "outputs": ["dist-electron/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    }
  }
}
