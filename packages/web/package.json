{
  "name": "@spiritagent/web",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Shared Spirit Workbench renderer and static application",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --strictPort --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build && pnpm run build:extension-ui",
    "build:extension-ui": "vite build --config vite.extension-ui.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-renderer-host-internal-imports.mjs && node scripts/check-renderer-agent-core-imports.mjs && vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
