{
  "name": "@spiritagent/create-extension",
  "version": "1.0.0-alpha.0",
  "description": "Scaffold Spirit extensions (npm create @spiritagent/extension). Thin alias over @spiritagent/extension-toolkit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/create-extension"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-extension": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "@spiritagent/extension-toolkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
