{
  "name": "@spiritagent/linear",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Linear MCP authorization through Spirit's OAuth client metadata",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && vite build --config vite.backend.config.ts && vite build --config vite.ui.config.ts && node scripts/emit-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/extension-toolkit": "workspace:*",
