{
  "name": "@spiritagent/config",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Configuration schema and atomic storage",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./write-lock": {
      "types": "./dist/write-lock.d.ts",
      "default": "./dist/write-lock.js"
    },
    "./keyring-secret": {
      "types": "./dist/keyring-secret.d.ts",
      "default": "./dist/keyring-secret.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@spiritagent/agent-core": "workspace:*",
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
