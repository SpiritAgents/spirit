{
  "name": "@spiritagent/code-completion",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Code completion orchestration and editor adapters",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./monaco": {
      "types": "./dist/core/to-monaco.d.ts",
      "default": "./dist/core/to-monaco.js"
    },
    "./delete-diff-preview": {
      "types": "./dist/core/delete-diff-preview.d.ts",
      "default": "./dist/core/delete-diff-preview.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/product": "workspace:*"
  },
  "devDependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
