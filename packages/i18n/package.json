{
  "name": "@spiritagent/i18n",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Shared Spirit localization resources and host runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    },
    "./ui-locale": {
      "types": "./dist/ui-locale.d.ts",
      "default": "./dist/ui-locale.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/product": "workspace:*",
    "i18next": "26.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
