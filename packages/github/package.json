{
  "name": "@spiritagent/github",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "GitHub authentication, API, pull request, and polling services",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./auth-storage": {
      "types": "./dist/auth-storage.d.ts",
      "default": "./dist/auth-storage.js"
    },
    "./oauth-bridge": {
      "types": "./dist/oauth-bridge.d.ts",
      "default": "./dist/oauth-bridge.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
