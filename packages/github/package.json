{
  "name": "@spiritagent/github",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "GitHub authentication, API, pull request, and polling services",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./auth-storage": {
      "types": "./dist/auth-storage.d.ts",
      "default": "./dist/auth-storage.js"
    },
    "./oauth-bridge": {
      "types": "./dist/oauth-bridge.d.ts",
      "default": "./dist/oauth-bridge.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build --config vite.backend.config.ts && vite build --config vite.ui.config.ts && node scripts/emit-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/automations": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/extension-toolkit": "workspace:*",
    "@spiritagent/i18n": "workspace:*",
    "@spiritagent/icons": "workspace:*",
    "@spiritagent/ui": "workspace:*",
    "i18next": "26.3.0",
    "lucide-react": "1.28.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.8"
  },
  "devDependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "26.13.0"
  }
}
