{
  "schemaVersion": 1,
  "name": "built-in",
  "displayName": "Built-in",
  "description": "Extensions bundled with the app.",
  "owner": {
    "name": "{{product.name}}",
    "url": "{{product.websiteOrigin}}"
  },
  "extensions": [
    {
      "name": "github",
      "version": "1.0.0",
      "source": "./extensions/github",
      "icon": "./extensions/github/icon.svg",
      "displayName": "GitHub",
      "description": "Native pull requests, authorization, and repository Automations for Spirit Desktop.",
      "author": {
        "name": "Spirit",
        "email": "hi@spirit.dev",
        "url": "https://spirit.dev"
      },
      "homepage": "https://spirit.dev",
      "category": "development",
      "keywords": ["pull requests", "repositories", "automations"],
      "reviewStatus": "verified",
      "defaultInstalled": true,
      "manifest": {
        "supportedHosts": ["desktop"],
        "activationEvents": ["onStartup"],
        "requestedCapabilities": [
          "settings",
          "secret-storage",
          "automation-triggers",
          "desktop-ui",
          "desktop-composer-attachments"
        ],
        "secretSlots": ["oauthCredentials"],
        "settingsSchema": [
          {
            "key": "pr-overview-ratio",
            "type": "number",
            "title": "Pull Request Overview Ratio",
            "defaultValue": 0.38
          },
          {
            "key": "pr-files-width",
            "type": "number",
            "title": "Changed Files Width",
            "defaultValue": 208
          }
        ],
        "contributes": {
          "authorizations": [
            {
              "id": "oauth",
              "action": "authorize",
              "secretSlots": ["oauthCredentials"]
            }
          ],
          "automationTriggers": [
            {
              "id": "activity",
              "name": "GitHub",
              "description": "New pull requests or issues in a repository.",
              "icon": {
                "type": "file",
                "path": "icons/github.svg",
                "monochrome": true
              },
              "configuration": "menu",
              "authorization": "oauth",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string"
                  },
                  "event": {
                    "type": "string",
                    "enum": ["pull_request_created", "issue_created"]
                  }
                },
                "required": ["owner", "repo", "event"],
                "additionalProperties": false
              }
            }
          ],
          "desktop": {
            "views": [
              {
                "id": "authorize",
                "path": "ui/authorize.html",
                "title": "GitHub",
                "width": 448,
                "chrome": "none"
              }
            ],
            "tabs": [
              {
                "id": "pull-requests",
                "name": "Pull Requests",
                "nameKey": "workspace.prTab",
                "path": "ui/pull-requests.html",
                "icon": {
                  "type": "file",
                  "path": "icons/pull-request.svg",
                  "monochrome": true
                },
                "defaultScope": "window-shared",
                "authorization": "oauth"
              }
            ],
            "linkHandlers": [
              {
                "id": "pull-request",
                "origins": ["https://github.com"],
                "tab": "pull-requests"
              }
            ]
          }
        }
      }
    }
  ]
}
