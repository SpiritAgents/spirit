{
  "schemaVersion": 1,
  "name": "built-in",
  "displayName": "Built-in",
  "description": "Extensions bundled with the app.",
  "owner": {
    "name": "{{product.name}}",
    "url": "{{product.websiteOrigin}}"
  },
  "extensions": [
    {
      "name": "github",
      "source": "./extensions/github",
      "icon": "./extensions/github/icon.svg",
      "reviewStatus": "verified",
      "defaultInstalled": false
    },
    {
      "name": "linear",
      "source": "./extensions/linear",
      "icon": "./extensions/linear/icon.svg",
      "reviewStatus": "verified",
      "defaultInstalled": false
    },
    {
      "name": "vercel",
      "source": "./extensions/vercel",
      "icon": "./extensions/vercel/icon.svg",
      "reviewStatus": "verified",
      "defaultInstalled": false
    }
  ]
}
