{
  "name": "@spiritagent/extensions",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Spirit extensions, marketplace, tasks, rules, and skills",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "default": "./dist/extensions.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "default": "./dist/marketplace/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/public.d.ts",
      "default": "./dist/tasks/public.js"
    },
    "./tasks-runtime": {
      "types": "./dist/tasks-runtime/index.d.ts",
      "default": "./dist/tasks-runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/product/generate-content.mjs --scope built-in && tsc -p tsconfig.build.json && node scripts/assemble-built-in-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/extension-toolkit": "workspace:*",
    "@spiritagent/host-internal": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "fflate": "0.8.3",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
