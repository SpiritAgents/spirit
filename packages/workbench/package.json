{
  "name": "@spiritagent/workbench",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Shared Workbench application composition root",
  "license": "MIT",
  "bin": {
    "spirit-workbench": "./dist/entry.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/automations": "workspace:*",
    "@spiritagent/code-completion": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/extensions": "workspace:*",
    "@spiritagent/github": "workspace:*",
    "@spiritagent/hooks": "workspace:*",
    "@spiritagent/http": "workspace:*",
    "@spiritagent/i18n": "workspace:*",
    "@spiritagent/instructions": "workspace:*",
    "@spiritagent/lsp": "workspace:*",
    "@spiritagent/permissions": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "@spiritagent/remote-control": "workspace:*",
    "@spiritagent/server": "workspace:*",
    "@spiritagent/sessions": "workspace:*",
    "@spiritagent/tasks": "workspace:*",
    "@spiritagent/ui": "workspace:*",
    "@spiritagent/web": "workspace:*",
    "@spiritagent/workspace": "workspace:*"
  },
  "devDependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/automations": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/extensions": "workspace:*",
    "@spiritagent/github": "workspace:*",
    "@spiritagent/hooks": "workspace:*",
    "@spiritagent/http": "workspace:*",
    "@spiritagent/i18n": "workspace:*",
    "@spiritagent/instructions": "workspace:*",
    "@spiritagent/lsp": "workspace:*",
    "@spiritagent/server": "workspace:*",
    "@spiritagent/sessions": "workspace:*",
    "@spiritagent/tasks": "workspace:*",
    "@spiritagent/ui": "workspace:*",
    "@spiritagent/web": "workspace:*",
    "@spiritagent/workspace": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "26.13.0"
  }
}
