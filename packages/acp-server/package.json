{
  "name": "@spiritagent/acp-server",
  "version": "1.0.0-alpha.0",
  "description": "ACP (Agent Client Protocol) server adapter for Spirit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/acp-server"
  },
  "bin": {
    "spirit-acp": "./dist/src/stdio-entry.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/src/stdio-entry.js",
  "types": "./dist/src/types.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs",
    "notice": "node scripts/gen-notice.mjs",
    "notice:production": "node scripts/gen-notice.mjs --production"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@inquirer/prompts": "7.10.1",
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/host-internal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
