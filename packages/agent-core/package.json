{
  "name": "@spiritagent/agent-core",
  "version": "1.0.0-alpha.0",
  "description": "TypeScript core runtime for Spirit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/agent-core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reasoning-effort": {
      "types": "./dist/reasoning-effort.d.ts",
      "default": "./dist/reasoning-effort.js"
    },
    "./model-thinking-controls": {
      "types": "./dist/model-thinking-controls.d.ts",
      "default": "./dist/model-thinking-controls.js"
    },
    "./shell-tool-result": {
      "types": "./dist/shell-tool-result.d.ts",
      "default": "./dist/shell-tool-result.js"
    },
    "./code-completion-to-monaco": {
      "types": "./dist/code-completion/to-monaco.d.ts",
      "default": "./dist/code-completion/to-monaco.js"
    },
    "./code-completion-delete-diff": {
      "types": "./dist/code-completion/delete-diff-preview.d.ts",
      "default": "./dist/code-completion/delete-diff-preview.js"
    },
    "./azure-resource": {
      "types": "./dist/azure-resource.d.ts",
      "default": "./dist/azure-resource.js"
    },
    "./cloudflare-ai-gateway-resource": {
      "types": "./dist/cloudflare-ai-gateway-resource.d.ts",
      "default": "./dist/cloudflare-ai-gateway-resource.js"
    },
    "./host-bridge": {
      "types": "./dist/host-bridge-public.d.ts",
      "default": "./dist/host-bridge-public.js"
    },
    "./extension-config-files": {
      "types": "./dist/extension-config-files.d.ts",
      "default": "./dist/extension-config-files.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:file": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs",
    "smoke:contract": "npm run build && node dist/smoke/contract/ai-sdk-openai-smoke.js && node dist/smoke/contract/ai-sdk-openai-json-schema-smoke.js && node dist/smoke/contract/ai-sdk-openai-streaming-smoke.js && node dist/smoke/contract/ai-sdk-openai-stream-reasoning-only-smoke.js && node dist/smoke/contract/ai-sdk-deepseek-streaming-smoke.js && node dist/smoke/contract/ai-sdk-deepseek-responses-smoke.js && node dist/smoke/contract/ai-sdk-anthropic-streaming-smoke.js && node dist/smoke/contract/ai-sdk-bedrock-streaming-smoke.js && node dist/smoke/contract/ai-sdk-google-streaming-smoke.js && node dist/smoke/contract/ai-sdk-google-vertex-streaming-smoke.js && node dist/smoke/contract/ai-sdk-open-responses-smoke.js && node dist/smoke/contract/ai-sdk-openai-responses-smoke.js && node dist/smoke/contract/ai-sdk-openai-responses-incremental-smoke.js && node dist/smoke/contract/ai-sdk-openai-apply-patch-smoke.js && node dist/smoke/contract/ai-sdk-gateway-apply-patch-smoke.js && node dist/smoke/contract/ai-sdk-gateway-web-search-smoke.js && node dist/smoke/contract/ai-sdk-openrouter-apply-patch-smoke.js && node dist/smoke/contract/ai-sdk-open-responses-streaming-smoke.js && node dist/smoke/contract/ai-sdk-alibaba-built-in-tools-smoke.js",
    "smoke:runtime": "npm run build && node dist/smoke/runtime/ai-sdk-openai-runtime-smoke.js && node dist/smoke/runtime/runtime-parity-smoke.js",
    "smoke:host-config": "npm run build && node dist/smoke/host-config/mcp-missing-env-smoke.js && node dist/smoke/host-config/mcp-stdio-cwd-smoke.js",
    "smoke:lsp": "pnpm --filter @spiritagent/host-internal run smoke:lsp",
    "smoke:offline": "npm run smoke:contract && npm run smoke:runtime && npm run smoke:host-config",
    "smoke:live": "npm run smoke:live:openai-compatible",
    "smoke:live:anthropic": "npm run build && node dist/smoke/live/ai-sdk-anthropic-live-smoke.js",
    "smoke:live:bedrock": "npm run build && node dist/smoke/live/ai-sdk-bedrock-live-smoke.js",
    "smoke:live:openai-compatible": "npm run build && node dist/smoke/live/ai-sdk-openai-compatible-live-smoke.js",
    "smoke:live:minimax-web-search": "npm run build && node dist/smoke/live/ai-sdk-minimax-web-search-live-smoke.js",
    "eval:scenario:validate": "npm run build && node dist/eval/validate-scenario.js",
    "eval:compare:dry-run": "npm run build && node dist/eval/compare-dry-run.js",
    "smoke:ai-sdk:openai:runtime": "npm run build && node dist/smoke/runtime/ai-sdk-openai-runtime-smoke.js",
    "smoke:ai-sdk:openai": "npm run build && node dist/smoke/contract/ai-sdk-openai-smoke.js",
    "smoke:ai-sdk:openai:json-schema": "npm run build && node dist/smoke/contract/ai-sdk-openai-json-schema-smoke.js",
    "smoke:ai-sdk:openai:streaming": "npm run build && node dist/smoke/contract/ai-sdk-openai-streaming-smoke.js",
    "smoke:ai-sdk:openai:stream-reasoning-only": "npm run build && node dist/smoke/contract/ai-sdk-openai-stream-reasoning-only-smoke.js",
    "smoke:ai-sdk:deepseek:streaming": "npm run build && node dist/smoke/contract/ai-sdk-deepseek-streaming-smoke.js",
    "smoke:ai-sdk:openai:all": "npm run smoke:ai-sdk:openai && npm run smoke:ai-sdk:openai:streaming && npm run smoke:ai-sdk:openai:stream-reasoning-only",
    "smoke:ai-sdk:anthropic:streaming": "npm run build && node dist/smoke/contract/ai-sdk-anthropic-streaming-smoke.js",
    "smoke:ai-sdk:open-responses": "npm run build && node dist/smoke/contract/ai-sdk-open-responses-smoke.js",
    "smoke:ai-sdk:openai-responses": "npm run build && node dist/smoke/contract/ai-sdk-openai-responses-smoke.js",
    "smoke:ai-sdk:open-responses:streaming": "npm run build && node dist/smoke/contract/ai-sdk-open-responses-streaming-smoke.js",
    "smoke:runtime:parity": "npm run build && node dist/smoke/runtime/runtime-parity-smoke.js",
    "smoke:mcp:missing-env": "npm run build && node dist/smoke/host-config/mcp-missing-env-smoke.js",
    "notice": "node scripts/gen-notice.mjs",
    "notice:production": "node scripts/gen-notice.mjs --production"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.37",
    "@ai-sdk/amazon-bedrock": "5.0.66",
    "@ai-sdk/anthropic": "4.0.44",
    "@ai-sdk/azure": "4.0.52",
    "@ai-sdk/baseten": "2.1.17",
    "@ai-sdk/cohere": "4.0.33",
    "@ai-sdk/deepinfra": "3.0.39",
    "@ai-sdk/deepseek": "3.0.35",
    "@ai-sdk/fireworks": "3.0.42",
    "@ai-sdk/gateway": "4.0.67",
    "@ai-sdk/google": "4.0.54",
    "@ai-sdk/google-vertex": "5.0.66",
    "@ai-sdk/groq": "4.0.33",
    "@ai-sdk/huggingface": "2.0.39",
    "@ai-sdk/minimax": "3.0.20",
    "@ai-sdk/moonshotai": "3.0.41",
    "@ai-sdk/open-responses": "2.0.34",
    "@ai-sdk/openai": "4.0.50",
    "@ai-sdk/openai-compatible": "3.0.39",
    "@ai-sdk/togetherai": "3.0.40",
    "@ai-sdk/xai": "4.0.47",
    "@aws/bedrock-token-generator": "1.1.0",
    "@huggingface/inference": "4.13.25",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.83",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
