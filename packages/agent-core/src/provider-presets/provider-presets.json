    {
      "id": "moonshot-ai",
      "label": "Moonshot AI",
      "defaultTransport": "openai-compatible",
      "sdk": "@ai-sdk/moonshotai",
      "transports": {
        "openai-compatible": "https://api.moonshot.ai/v1"
      },
      "sites": {
        "default": "intl",
        "items": [
          { "id": "cn", "label": "China", "apiBase": "https://api.moonshot.cn/v1" },
          { "id": "intl", "label": "International", "apiBase": "https://api.moonshot.ai/v1" }
        ]
      },
      "credentials": { "kind": "apiKey" },
      "providerTools": [
        {
          "label": "Web Search",
          "tools": [
            {
              "type": "moonshot_formula",
              "formula_uri": "moonshot/web-search:latest",
              "function_name": "web_search"
            }
          ],
          "toolsFrom": { "path": "/formulas/moonshot/web-search:latest/tools" },
          "execute": {
            "path": "/formulas/moonshot/web-search:latest/fibers",
            "body": { "name": "{toolName}", "arguments": "{argumentsJson}" },
            "statusPath": "status",
            "okValue": "succeeded",
            "errorPath": ["error", "context.error", "context.output"],
            "resultPath": ["context.encrypted_output", "context.output"]
          },
          "ui": { "expand": false }
        }
      ],
      "fileUpload": {
        "path": "/files",
        "purpose": { "video": "video" },
        "refTemplate": "ms://{id}"
      },
      "catalog": { "parser": "moonshot-models", "endpoint": "/models" }
    },
    {
      "id": "kimi-code",
      "label": "Kimi Code",
      "defaultTransport": "openai-compatible",
      "sdk": "@ai-sdk/openai-compatible",
      "transports": {
        "openai-compatible": "https://api.kimi.ai/coding/v1",
        "anthropic": "https://api.kimi.ai/coding"
      },
      "sites": {
        "default": "intl",
        "items": [
          {
            "id": "cn",
            "label": "China",
            "transports": {
              "openai-compatible": "https://api.kimi.com/coding/v1",
              "anthropic": "https://api.kimi.com/coding"
            }
          },
          {
            "id": "intl",
            "label": "International",
            "transports": {
              "openai-compatible": "https://api.kimi.ai/coding/v1",
              "anthropic": "https://api.kimi.ai/coding"
            }
          }
        ]
      },
      "credentials": { "kind": "apiKey" },
      "body": { "stream_options": { "include_usage": true } },
      "providerTools": [
        {
          "label": "Web Search",
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "web_search",
                "description": "Search the web for up-to-date information. Returns page titles, URLs, snippets, and content.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string", "description": "Search query." }
                  },
                  "required": ["query"],
                  "additionalProperties": false
                }
              }
            }
          ],
          "execute": {
            "path": "/search",
            "body": { "text_query": "{arg.query}" },
            "resultsPath": "search_results",
            "fields": {
              "title": "title",
              "url": "url",
              "site": "site_name",
              "time": "date",
              "snippet": "snippet",
              "content": "content"
            }
          }
        }
      ],
      "fileUpload": {
        "path": "/files",
        "purpose": { "video": "video" },
        "refTemplate": "ms://{id}"
      },
      "catalog": { "parser": "kimi-code-models", "endpoint": "/models" }
    },
