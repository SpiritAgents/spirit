{
  "models": [
    {
      "match": "muse-spark-(?:1\\.(?:[3-9]|[1-9]\\d+)|[2-9]|[1-9]\\d+)\\S*[-_]contributor(?:$|[-_])",
      "declare": {
        "supportedReasoningEfforts": ["minimal", "low", "medium", "high", "xhigh"]
      },
      "note": "Spark 1.3+ contributor builds still omit max even though the base 1.3 generation gained it."
    },
    {
      "match": "muse-spark-(?:0(?:\\.\\d+)?(?:$|[-_.])|1(?:\\.[0-2])?(?:$|[-_]))",
      "declare": {
        "supportedReasoningEfforts": ["minimal", "low", "medium", "high", "xhigh"]
      },
      "note": "Spark before 1.3 never had max; this covers contributor builds of those versions too."
    },
    {
      "match": "muse-spark-(?:1\\.(?:[3-9]|[1-9]\\d+)|[2-9]|[1-9]\\d+)",
      "declare": {
        "supportedReasoningEfforts": ["minimal", "low", "medium", "high", "xhigh", "max"]
      },
      "note": "Spark gained max at 1.3."
    },
    {
      "match": "muse-wonder-\\d",
      "declare": {
        "supportedReasoningEfforts": ["minimal", "low", "medium", "high", "xhigh", "max"]
      },
      "note": "Wonder includes max at every parsed version; the contributor exclusion is Spark-only."
    }
  ]
}
