{
  "models": [
    {
      "match": "(?:anthropic\\.)?claude-(?:fable|mythos)-5(?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
        "supportsThinkingType": "only"
      },
      "note": "Claude Fable/Mythos 5: always-on adaptive thinking that the API cannot disable (thinkingSwitchable: false in routed-anthropic-claude-capabilities.ts)."
    },
    {
      "match": "(?:anthropic\\.)?claude-opus-5(?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
        "supportsThinkingSwitch": true
      },
      "note": "Claude Opus 5 generation: adaptive thinking with the full effort ladder. The optional `anthropic.` prefix covers Bedrock ids such as anthropic.claude-opus-5-5-v1."
    },
    {
      "match": "(?:anthropic\\.)?claude-sonnet-5(?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
        "supportsThinkingSwitch": true
      }
    },
    {
      "match": "(?:anthropic\\.)?claude-opus-4[.-][78](?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
        "supportsThinkingSwitch": true
      },
      "note": "Claude Opus 4.7/4.8: adaptive thinking with the full effort ladder; the source normalizes 4.7/4.8 dotted ids to dashes, so both separators are accepted."
    },
    {
      "match": "(?:anthropic\\.)?claude-opus-4[.-]6(?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high", "max"],
        "supportsThinkingSwitch": true
      }
    },
    {
      "match": "(?:anthropic\\.)?claude-sonnet-4[.-]6(?:$|[-_.])",
      "declare": {
        "supportedReasoningEfforts": ["low", "medium", "high"],
        "supportsThinkingSwitch": true
      }
    },
    {
      "match": "(?:anthropic\\.)?claude-(?:(?:haiku|opus|sonnet)-4[.-]5|(?:opus|sonnet)-4)(?:$|[-_.])",
      "declare": {
        "supportsThinkingSwitch": true
      },
      "note": "Legacy Claude (4.5 families, Opus 4.1, base Opus/Sonnet 4): budget thinking — switchable, but with no effort levels, so supportedReasoningEfforts stays undeclared."
    }
  ]
}
