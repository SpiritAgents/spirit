{
  "models": [
    {
      "match": "deepseek-v4-",
      "declare": {
        "supportedReasoningEfforts": ["high", "max"],
        "supportsThinkingSwitch": true,
        "thinkingSwitch": {
          "on": {
            "body": {
              "thinking": {
                "type": "enabled"
              }
            }
          },
          "off": {
            "body": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      },
      "note": "DeepSeek V4 (pro, flash, flash-vision-exp, …): hybrid thinking — the API accepts reasoning_effort high/max only while thinking is enabled."
    },
    {
      "match": "deepseek-r1",
      "declare": {
        "supportsThinkingType": "only"
      },
      "note": "DeepSeek R1 always thinks and has no thinking toggle."
    },
    {
      "match": "deepseek-reasoner",
      "declare": {
        "supportsThinkingType": "only"
      },
      "note": "DeepSeek R1 always thinks and has no thinking toggle."
    }
  ]
}
