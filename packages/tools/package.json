{
  "name": "@spiritagent/tools",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Built-in host tool execution for Spirit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/automations": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/instructions": "workspace:*",
    "@spiritagent/permissions": "workspace:*",
    "@spiritagent/process": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "@spiritagent/workspace": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "glob": "13.0.6",
    "ignore": "5.3.2",
    "jsdom": "30.0.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
