{
  "name": "@spiritagent/ui",
  "version": "1.0.0-alpha.0",
  "description": "Shared React UI primitives for Spirit desktop and site",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/theme.css",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "default": "./dist/cn.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@radix-ui/react-scroll-area": ">=1.2.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "radix-ui": ">=1.4.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
