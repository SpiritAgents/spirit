{
  "name": "@spiritagent/server",
  "version": "1.0.0-alpha.0",
  "description": "Shared agent daemon backend for CLI, Desktop and Web clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/server"
  },
  "bin": {
    "spirit-server": "./dist/src/entry.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/src/entry.js",
  "types": "./dist/src/protocol/index.d.ts",
  "exports": {
    ".": "./dist/src/protocol/index.js",
    "./client": "./dist/src/client.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs"
  },
  "dependencies": {
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/host-internal": "workspace:*",
    "@spiritagent/product": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
