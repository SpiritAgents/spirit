{
  "name": "@spiritagent/host-internal",
  "version": "1.0.0-alpha.0",
  "description": "Internal TypeScript agent host implementations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiritAgents/spirit.git",
    "directory": "packages/host-internal"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default-terminal-shell": {
      "types": "./dist/default-terminal-shell.d.ts",
      "default": "./dist/default-terminal-shell.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./approval-level": {
      "types": "./dist/approval-level.d.ts",
      "default": "./dist/approval-level.js"
    },
    "./work-location": {
      "types": "./dist/work-location.d.ts",
      "default": "./dist/work-location.js"
    },
    "./local-file-composer-route": {
      "types": "./dist/local-file-composer-route.d.ts",
      "default": "./dist/local-file-composer-route.js"
    },
    "./hooks/trust": {
      "types": "./dist/hooks/trust.d.ts",
      "default": "./dist/hooks/trust.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./azure-resource": {
      "types": "./dist/azure-resource.d.ts",
      "default": "./dist/azure-resource.js"
    },
    "./cloudflare-ai-gateway-resource": {
      "types": "./dist/cloudflare-ai-gateway-resource.d.ts",
      "default": "./dist/cloudflare-ai-gateway-resource.js"
    },
    "./reasoning-effort": {
      "types": "./dist/reasoning-effort.d.ts",
      "default": "./dist/reasoning-effort.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./skill-paths": {
      "types": "./dist/skill-paths.d.ts",
      "default": "./dist/skill-paths.js"
    },
    "./tool-output-archive-path": {
      "types": "./dist/tool-output-archive-path.d.ts",
      "default": "./dist/tool-output-archive-path.js"
    },
    "./background-task-path": {
      "types": "./dist/background-task-path.d.ts",
      "default": "./dist/background-task-path.js"
    },
    "./image-file-support": {
      "types": "./dist/image-file-support.d.ts",
      "default": "./dist/image-file-support.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./workspace-file-reference-query": {
      "types": "./dist/workspace-file-reference-query.d.ts",
      "default": "./dist/workspace-file-reference-query.js"
    },
    "./workspace-file-references": {
      "types": "./dist/workspace-file-references.d.ts",
      "default": "./dist/workspace-file-references.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:workspace-file-references": "vitest run src/workspace-file-references.test.ts",
    "test:lsp": "vitest run src/lsp",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "notice": "node scripts/gen-notice.mjs",
    "notice:production": "node scripts/gen-notice.mjs --production",
    "prepublishOnly": "pnpm run build && node ../../scripts/publish/assert-no-workspace-deps.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1103.0",
    "@mozilla/readability": "0.6.0",
    "@spiritagent/agent-core": "workspace:*",
    "@spiritagent/api": "workspace:*",
    "@spiritagent/automations": "workspace:*",
    "@spiritagent/config": "workspace:*",
    "@spiritagent/extension-toolkit": "workspace:*",
    "@spiritagent/hooks": "workspace:*",
    "@spiritagent/instructions": "workspace:*",
    "@spiritagent/mcp": "workspace:*",
    "@spiritagent/permissions": "workspace:*",
    "@spiritagent/process": "workspace:*",
    "@spiritagent/product": "workspace:*",
    "@spiritagent/workspace": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "fast-glob": "3.3.3",
    "fflate": "0.8.3",
    "glob": "13.0.6",
    "google-auth-library": "10.9.1",
    "ignore": "5.3.2",
    "jsdom": "30.0.1",
    "tar": "7.5.22",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.18.2"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "26.13.0"
  }
}
